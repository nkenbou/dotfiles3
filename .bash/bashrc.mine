# fcitx5 の起動管理
if [ $SHLVL = 1 ] ; then
    if [ -n "$MY_FCITX5_PID" ] && kill -0 "$MY_FCITX5_PID" 2>/dev/null; then
        kill "$MY_FCITX5_PID" 2>/dev/null
    fi
    
    # fcitx5 を起動してPIDを記録
    # -d (デーモン化) を使うと $! が即終了する親プロセスの PID になり、
    # ジョブ終了通知 ([1]+ Done ...) が出るうえ PID も追跡できないため使わない
    fcitx5 --disable=wayland --verbose '*'=0 >/dev/null 2>&1 &
    export MY_FCITX5_PID=$!
    disown
    
    # ターミナル終了時のクリーンアップ処理
    cleanup_processes() {
        if [ -n "$MY_FCITX5_PID" ] && kill -0 "$MY_FCITX5_PID" 2>/dev/null; then
            kill "$MY_FCITX5_PID" 2>/dev/null
        fi
    }
    
    # EXIT, TERM, INT シグナルでクリーンアップを実行
    trap cleanup_processes EXIT TERM INT
fi

# functions の読み込み
if [ -d ~/.bash/functions ]; then
    for func in ~/.bash/functions/*; do
        [ -f "$func" ] && source "$func"
    done
fi

bind -x '"\300": g'
bind '"\C-g":"\300\C-m"'

# mise
eval "$(mise activate bash)"
